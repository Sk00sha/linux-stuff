#!/usr/bin/env python3
"""course — command-line companion for "Linux Basics — Hands-On".

Python 3 standard library only. Run `course --help` for the commands.
"""

import argparse
import datetime
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import textwrap

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))
import miniyaml  # noqa: E402

COMPOSE_FILE = os.path.join(ROOT, "runtime", "docker", "compose.yaml")
VM_DIR = os.path.join(ROOT, "runtime", "vm")
PROGRESS_FILE = os.environ.get(
    "COURSE_PROGRESS_FILE",
    os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")),
                 "linux-basics-course", "progress.json"))

# image -> compose service that knows how to build it
IMAGE_BUILDERS = {
    "lbc/ubuntu:1.0": "ubuntu",
    "lbc/rocky:1.0": "rocky",
    "lbc/systemd-ubuntu:1.0": "systemd",
    "lbc/dns:1.0": "dns",
}
SERVICE_IMAGES = {
    "ubuntu": "lbc/ubuntu:1.0", "client": "lbc/ubuntu:1.0", "router": "lbc/ubuntu:1.0",
    "web01": "lbc/ubuntu:1.0", "db01": "lbc/ubuntu:1.0", "devbox": "lbc/ubuntu:1.0",
    "app01": "lbc/ubuntu:1.0", "rocky": "lbc/rocky:1.0", "dns": "lbc/dns:1.0",
    "systemd": "lbc/systemd-ubuntu:1.0", "demo-web": "lbc/systemd-ubuntu:1.0",
}

USE_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def c(text, code):
    return "\033[%sm%s\033[0m" % (code, text) if USE_COLOR else text


def bold(t):
    return c(t, "1")


def green(t):
    return c(t, "32")


def red(t):
    return c(t, "31")


def dim(t):
    return c(t, "2")


def die(msg, code=1):
    print(red("error: ") + msg, file=sys.stderr)
    sys.exit(code)


# --------------------------------------------------------------------------
# Course model
# --------------------------------------------------------------------------

def front_matter(path):
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---\n", 4)
    if end < 0:
        return {}, text
    return miniyaml.loads(text[4:end]) or {}, text[end + 5:]


class Course:
    def __init__(self):
        self.data = miniyaml.load(os.path.join(ROOT, "course.yaml"))
        self.items = []  # flat list of dicts with module, type, path, id, title, minutes
        for mod in self.data["modules"]:
            for it in mod["items"]:
                item = dict(it)
                item["module"] = mod["id"]
                item["abspath"] = os.path.join(ROOT, it["path"])
                self._enrich(item)
                self.items.append(item)

    def _enrich(self, item):
        t = item["type"]
        p = item["abspath"]
        item.setdefault("minutes", {"story": 2, "quiz": 3}.get(t, 10))
        try:
            if t in ("lesson", "story"):
                fm, _ = front_matter(p)
                item["id"] = fm.get("id", item["module"] + "/" + os.path.splitext(os.path.basename(p))[0])
                item["title"] = fm.get("title") or self._md_title(p)
                if t == "lesson" and fm.get("minutes"):
                    item["minutes"] = fm["minutes"]
            elif t == "quiz":
                q = miniyaml.load(p)
                item["id"] = q["id"]
                item["title"] = q.get("title") or "Quiz: " + q["id"].split("/")[-1].split("-", 1)[-1].replace("-", " ")
                item["questions"] = len(q.get("questions", []))
            elif t == "lab":
                lab = miniyaml.load(os.path.join(p, "lab.yaml"))
                item["id"] = lab["id"]
                item["title"] = lab["title"]
                item["minutes"] = lab.get("minutes", item["minutes"])
                item["lab"] = lab
        except (OSError, KeyError, miniyaml.YAMLError) as e:
            item.setdefault("id", item["path"])
            item.setdefault("title", "(unreadable: %s)" % e)

    @staticmethod
    def _md_title(path):
        try:
            with open(path, encoding="utf-8") as fh:
                for line in fh:
                    if line.startswith("# "):
                        return line[2:].strip()
        except OSError:
            pass
        return os.path.basename(path)

    def module(self, mid):
        for m in self.data["modules"]:
            if m["id"] == mid:
                return m
        return None

    def find(self, query, types=None):
        cands = [i for i in self.items if types is None or i["type"] in types]
        for rule in (lambda i: i["id"] == query,
                     lambda i: i["id"].split("/")[-1] == query,
                     lambda i: i["id"].split("/")[-1].split("-", 1)[-1] == query,
                     lambda i: query in i["id"]):
            hits = [i for i in cands if rule(i)]
            if len(hits) == 1:
                return hits[0]
            if len(hits) > 1:
                die("'%s' is ambiguous: %s" % (query, ", ".join(h["id"] for h in hits)))
        die("no %s matches '%s' (try `course list`)" % ("/".join(types or ["item"]), query))


# --------------------------------------------------------------------------
# Progress
# --------------------------------------------------------------------------

def load_progress():
    try:
        with open(PROGRESS_FILE, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {"lessons": {}, "quizzes": {}, "labs": {}, "hints": {}}


def save_progress(p):
    os.makedirs(os.path.dirname(PROGRESS_FILE), exist_ok=True)
    tmp = PROGRESS_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(p, fh, indent=2, sort_keys=True)
    os.replace(tmp, PROGRESS_FILE)


def now():
    return datetime.datetime.now().isoformat(timespec="seconds")


def item_done(progress, item):
    t = item["type"]
    if t in ("lesson", "story"):
        return item["id"] in progress.get("lessons", {})
    if t == "quiz":
        return progress.get("quizzes", {}).get(item["id"], {}).get("passed", False)
    if t == "lab":
        return item["id"] in progress.get("labs", {})
    return False


# --------------------------------------------------------------------------
# Commands: list / syllabus / progress / read
# --------------------------------------------------------------------------

ICONS = {"story": "story ", "lesson": "lesson", "quiz": "quiz  ", "lab": "lab   "}


def cmd_list(args):
    course = Course()
    prog = load_progress()
    print(bold(course.data["title"]) + dim("  v%s" % course.data.get("version", "?")))
    for mod in course.data["modules"]:
        if args.module and args.module not in mod["id"]:
            continue
        items = [i for i in course.items if i["module"] == mod["id"]]
        done = sum(item_done(prog, i) for i in items)
        print("\n" + bold("%s  %s" % (mod["id"], mod["title"])) +
              dim("  [runtime: %s] %d/%d done" % (mod["runtime"], done, len(items))))
        for i in items:
            mark = green("✔") if item_done(prog, i) else " "
            print("  %s %s  %-52s %s" % (mark, ICONS[i["type"]], i["title"][:52],
                                         dim(i["id"])))
    return 0


def cmd_syllabus(args):
    course = Course()
    out = ["# Syllabus — %s" % course.data["title"], "",
           "Generated from `course.yaml` by `bin/course syllabus`. Do not edit by hand.", ""]
    total = 0
    summary = ["| Module | Runtime | Lessons | Quizzes | Labs | Est. time |",
               "|---|---|---|---|---|---|"]
    body = []
    for mod in course.data["modules"]:
        items = [i for i in course.items if i["module"] == mod["id"]]
        mins = sum(int(i["minutes"]) for i in items)
        total += mins
        count = {t: sum(1 for i in items if i["type"] == t) for t in ICONS}
        summary.append("| %s %s | %s | %d | %d | %d | %s |" % (
            mod["id"][:2], mod["title"], mod["runtime"], count["lesson"], count["quiz"],
            count["lab"], fmt_minutes(mins)))
        body += ["## %s — %s" % (mod["id"], mod["title"]), "",
                 "Runtime: **%s** · Estimated time: **%s**" % (mod["runtime"], fmt_minutes(mins)), "",
                 "| # | Type | Title | Minutes | Path |", "|---|---|---|---|---|"]
        for n, i in enumerate(items, 1):
            path = i["path"]
            body.append("| %d | %s | %s | %s | [`%s`](%s) |" % (
                n, i["type"], i["title"].replace("|", "\\|"), i["minutes"],
                path.split("/", 2)[-1], path))
        body.append("")
    summary.append("| **Total** | | | | | **%s** |" % fmt_minutes(total))
    print("\n".join(out + summary + [""] + body).rstrip())
    return 0


def fmt_minutes(m):
    m = int(m)
    return "%dh %02dm" % (m // 60, m % 60) if m >= 60 else "%dm" % m


def cmd_progress(args):
    course = Course()
    prog = load_progress()
    rows = []
    tot = {"lesson": [0, 0], "quiz": [0, 0], "lab": [0, 0]}
    for mod in course.data["modules"]:
        items = [i for i in course.items if i["module"] == mod["id"]]
        row = [mod["id"]]
        for t in ("lesson", "quiz", "lab"):
            sel = [i for i in items if i["type"] == t]
            d = sum(item_done(prog, i) for i in sel)
            tot[t][0] += d
            tot[t][1] += len(sel)
            row.append("%d/%d" % (d, len(sel)))
        rows.append(row)
    rows.append(["TOTAL"] + ["%d/%d" % tuple(tot[t]) for t in ("lesson", "quiz", "lab")])
    print("%-32s %8s %8s %8s" % ("Module", "Lessons", "Quizzes", "Labs"))
    for r in rows:
        print("%-32s %8s %8s %8s" % tuple(r))
    print(dim("\nprogress file: %s" % PROGRESS_FILE))
    return 0


def cmd_read(args):
    course = Course()
    item = course.find(args.id, ("lesson", "story"))
    with open(item["abspath"], encoding="utf-8") as fh:
        text = fh.read()
    pager = os.environ.get("PAGER", "less -R")
    if sys.stdout.isatty() and shutil.which(pager.split()[0]) and not args.no_pager:
        subprocess.run(pager, shell=True, input=text.encode())
    else:
        print(text)
    prog = load_progress()
    prog.setdefault("lessons", {})[item["id"]] = now()
    save_progress(prog)
    return 0


# --------------------------------------------------------------------------
# Quiz
# --------------------------------------------------------------------------

def cmd_quiz(args):
    course = Course()
    item = course.find(args.id, ("quiz",))
    quiz = miniyaml.load(item["abspath"])
    qs = quiz["questions"]
    scripted = args.answers.split(",") if args.answers else None
    if scripted and len(scripted) != len(qs):
        die("--answers needs %d comma-separated answers" % len(qs))
    print(bold(item["title"]) + dim("  (%d questions, pass mark %d%%)" % (
        len(qs), round(quiz.get("pass_mark", 0.7) * 100))))
    score = 0
    for n, q in enumerate(qs, 1):
        print("\n" + bold("Q%d. " % n) + textwrap.fill(q["prompt"], 76, subsequent_indent="    "))
        for key in sorted(q["options"]):
            print("    %s) %s" % (key, q["options"][key]))
        if scripted:
            ans = scripted[n - 1].strip().lower()
        else:
            while True:
                try:
                    ans = input("  your answer: ").strip().lower()
                except EOFError:
                    print()
                    return 130
                if ans in q["options"]:
                    break
                print("  please type one of: " + ", ".join(sorted(q["options"])))
        if ans == str(q["answer"]):
            score += 1
            print("  " + green("correct."), textwrap.fill(q["explanation"], 70, subsequent_indent="  "))
        else:
            print("  " + red("not quite") + " — the answer is %s) %s" % (q["answer"], q["options"][q["answer"]]))
            print("  " + textwrap.fill(q["explanation"], 74, subsequent_indent="  "))
    ratio = score / len(qs)
    passed = ratio >= quiz.get("pass_mark", 0.7)
    print("\n" + bold("Score: %d/%d" % (score, len(qs))) + "  " +
          (green("PASSED") if passed else red("not passed yet — reread the lesson and try again")))
    prog = load_progress()
    prev = prog.setdefault("quizzes", {}).get(item["id"], {})
    best = max(prev.get("best", 0), score)
    prog["quizzes"][item["id"]] = {"best": best, "of": len(qs), "last": score,
                                   "passed": prev.get("passed", False) or passed, "at": now()}
    save_progress(prog)
    return 0 if passed else 1


# --------------------------------------------------------------------------
# Labs
# --------------------------------------------------------------------------

def lab_context(item, runtime_override=None):
    lab = item["lab"]
    runtime = runtime_override or lab["runtime"]
    services = lab.get("services", [])
    fb = lab.get("fallback") or {}
    if runtime_override is None and runtime == "vm" and fb and vm_tool() == "none":
        print(dim("No course VM found; using the %s fallback for this lab (see lab README)." % fb["runtime"]))
        runtime = fb["runtime"]
    if runtime != lab["runtime"]:
        if not fb or fb.get("runtime") != runtime:
            die("lab %s cannot run on runtime '%s'" % (item["id"], runtime))
        services = fb["services"]
    login = dict(lab.get("login") or {})
    if runtime != lab["runtime"] and fb.get("login"):
        login = dict(fb["login"])
    login.setdefault("service", services[0])
    login.setdefault("user", "bob")
    env = dict(os.environ)
    env.update({"COURSE_ROOT": ROOT, "COURSE_RUNTIME": runtime, "LAB_ID": item["id"],
                "LAB_HOST": login["service"], "LAB_DIR": item["abspath"]})
    return {"runtime": runtime, "services": services, "login": login, "env": env, "lab": lab}


def vm_tool():
    if os.environ.get("COURSE_VM_TOOL"):
        return os.environ["COURSE_VM_TOOL"]
    out = subprocess.run(["bash", "-c", ". '%s/lib/runtime.sh'; course_vm_tool" % ROOT],
                         capture_output=True, text=True)
    return out.stdout.strip() or "none"


def compose(*args, check=True, quiet=False):
    cmd = ["docker", "compose", "-f", COMPOSE_FILE, "--profile", "*"] + list(args)
    kw = {"stdout": subprocess.DEVNULL, "stderr": subprocess.STDOUT} if quiet else {}
    r = subprocess.run(cmd, **kw)
    if check and r.returncode != 0:
        die("command failed: %s" % " ".join(cmd))
    return r.returncode


def ensure_images(services):
    needed = sorted({SERVICE_IMAGES[s] for s in services if s in SERVICE_IMAGES})
    for img in needed:
        if subprocess.run(["docker", "image", "inspect", img], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode != 0:
            print(dim("building image %s (first run only, can take several minutes)..." % img))
            compose("build", IMAGE_BUILDERS[img])


def bring_up(ctx, fresh=False):
    if ctx["runtime"] == "docker":
        if not shutil.which("docker"):
            die("docker is not installed (see README: Prerequisites)")
        ensure_images(ctx["services"])
        args = ["up", "-d", "--no-build", "--wait"]
        if fresh:
            args.append("--force-recreate")
        compose(*(args + ctx["services"]))
    else:
        if vm_tool() == "none":
            die("this lab needs the course VM. Run `make vm-up` first (see README: VM runtime).")


def run_script(ctx, script):
    path = os.path.join(ctx["env"]["LAB_DIR"], script)
    return subprocess.run(["bash", path], env=ctx["env"]).returncode


def login_shell(ctx):
    svc, user = ctx["login"]["service"], ctx["login"]["user"]
    home = "/root" if user == "root" else "/home/%s" % user
    if ctx["runtime"] == "docker":
        cmd = ["docker", "exec", "-it", "-u", user, "-w", home, "-e", "HOME=" + home,
               "lbc-" + svc, "bash", "-l"]
    else:
        tool = vm_tool()
        inner = "sudo -iu %s" % user
        cmd = {"vagrant": ["vagrant", "ssh", svc, "-c", inner],
               "incus": ["incus", "exec", svc, "--", "bash", "-c", inner],
               "multipass": ["multipass", "exec", svc, "--", "bash", "-c", inner],
               "lima": ["limactl", "shell", svc, "bash", "-c", inner]}[tool]
    print(dim("Entering %s as %s. Type `exit` to leave; then run: course check %s" % (
        svc, user, ctx["env"]["LAB_ID"])))
    return subprocess.run(cmd, cwd=VM_DIR if ctx["runtime"] == "vm" else None).returncode


def cmd_start(args):
    course = Course()
    item = course.find(args.lab, ("lab",))
    ctx = lab_context(item, args.runtime)
    print(bold("Lab: %s" % item["title"]) + dim("  [%s: %s]" % (ctx["runtime"], ", ".join(ctx["services"]))))
    bring_up(ctx, fresh=args.fresh)
    rc = run_script(ctx, "setup.sh")
    if rc != 0:
        die("setup.sh failed (exit %d)" % rc, rc)
    print(green("Lab ready.") + " Tasks: %s" % os.path.relpath(os.path.join(item["abspath"], "README.md")))
    if ctx["lab"].get("hide_tasks"):
        print("  (symptoms only — read the README; `course check` reports health per area)")
    for t in ([] if ctx["lab"].get("hide_tasks") else ctx["lab"].get("tasks", [])):
        print("  %s  %s" % (bold(t["id"]), textwrap.fill(t["text"], 72, subsequent_indent="      ")))
    if args.no_shell or not sys.stdin.isatty():
        return 0
    return login_shell(ctx)


def cmd_shell(args):
    course = Course()
    item = course.find(args.lab, ("lab",))
    ctx = lab_context(item, args.runtime)
    if args.service:
        ctx["login"] = {"service": args.service, "user": args.user or ctx["login"]["user"]}
    elif args.user:
        ctx["login"]["user"] = args.user
    return login_shell(ctx)


def cmd_check(args):
    course = Course()
    item = course.find(args.lab, ("lab",))
    ctx = lab_context(item, args.runtime)
    rc = run_script(ctx, "check.sh")
    if rc == 0:
        prog = load_progress()
        prog.setdefault("labs", {})[item["id"]] = now()
        save_progress(prog)
        print(green(bold("Lab complete!")) + " Progress saved.")
    else:
        print(dim("Not there yet. Stuck? course hint %s <task>" % item["id"].split("/")[-1]))
    return rc


def cmd_reset(args):
    course = Course()
    item = course.find(args.lab, ("lab",))
    ctx = lab_context(item, args.runtime)
    bring_up(ctx, fresh=args.fresh)
    rc = run_script(ctx, "setup.sh")
    if rc == 0:
        print(green("Lab reset to its starting state."))
    return rc


def parse_hints(path):
    hints = {}
    task = None
    level = None
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            m = re.match(r"^##\s+(t\d+)\b", line)
            if m:
                task, level = m.group(1), None
                hints[task] = []
                continue
            m = re.match(r"^###\s+", line)
            if m and task:
                hints[task].append("")
                level = len(hints[task]) - 1
                continue
            if task is not None and level is not None:
                hints[task][level] += line
    return {k: [h.strip() for h in v] for k, v in hints.items()}


def cmd_hint(args):
    course = Course()
    item = course.find(args.lab, ("lab",))
    hints = parse_hints(os.path.join(item["abspath"], "hints.md"))
    if args.task not in hints:
        die("no hints for task '%s' (tasks: %s)" % (args.task, ", ".join(sorted(hints))))
    prog = load_progress()
    key = "%s:%s" % (item["id"], args.task)
    seen = prog.setdefault("hints", {}).get(key, 0)
    level = args.level or min(seen + 1, len(hints[args.task]))
    if level < 1 or level > len(hints[args.task]):
        die("levels available: 1-%d" % len(hints[args.task]))
    names = {1: "nudge", 2: "which command", 3: "almost the answer"}
    print(bold("Hint %d/%d for %s (%s)" % (level, len(hints[args.task]), args.task, names.get(level, ""))))
    print(hints[args.task][level - 1])
    prog["hints"][key] = max(seen, level)
    save_progress(prog)
    if level < len(hints[args.task]):
        print(dim("\nRun the same command again for the next hint."))
    return 0


def cmd_solution(args):
    course = Course()
    item = course.find(args.lab, ("lab",))
    if sys.stdin.isatty() and not args.yes:
        ans = input("Show the full solution for %s? Trying first teaches more. [y/N] " % item["id"])
        if ans.strip().lower() not in ("y", "yes"):
            return 1
    with open(os.path.join(item["abspath"], "solution.md"), encoding="utf-8") as fh:
        print(fh.read())
    return 0


SOLUTION_FENCE = re.compile(r"^```bash\s+solution\b(.*)$")


def solution_blocks(path):
    blocks = []
    cur = None
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            if cur is None:
                m = SOLUTION_FENCE.match(line.rstrip("\n"))
                if m:
                    attrs = dict(re.findall(r"(\w+)=(\S+)", m.group(1)))
                    cur = {"attrs": attrs, "lines": []}
            elif line.startswith("```"):
                blocks.append(cur)
                cur = None
            else:
                cur["lines"].append(line)
    return blocks


def cmd_solution_script(args):
    """Emit a bash script that applies solution.md (used by tests/test_labs.sh)."""
    course = Course()
    item = course.find(args.lab, ("lab",))
    ctx = lab_context(item, args.runtime)
    out = ["#!/usr/bin/env bash", "set -euo pipefail",
           ". %s/lib/runtime.sh" % ROOT]
    for n, b in enumerate(solution_blocks(os.path.join(item["abspath"], "solution.md"))):
        target = b["attrs"].get("target", "@host")
        if target == "@host":
            target = ctx["login"]["service"]
        user = b["attrs"].get("user", "root")
        if b["attrs"].get("runtime") and b["attrs"]["runtime"] != ctx["runtime"]:
            continue
        out.append("echo '>>> solution block %d on %s as %s'" % (n + 1, target, user))
        out.append("_remote %s %s <<'__COURSE_SOLUTION_%d__'" % (target, user, n))
        out.append("set -e")
        out.append("".join(b["lines"]).rstrip("\n"))
        out.append("__COURSE_SOLUTION_%d__" % n)
    print("\n".join(out))
    return 0


def cmd_info(args):
    course = Course()
    item = course.find(args.lab, ("lab",))
    ctx = lab_context(item, args.runtime)
    info = {"id": item["id"], "module": item["module"], "dir": item["abspath"],
            "runtime": ctx["runtime"], "services": ctx["services"], "login": ctx["login"]}
    if args.field:
        v = info[args.field]
        print(" ".join(v) if isinstance(v, list) else (json.dumps(v) if isinstance(v, dict) else v))
    else:
        print(json.dumps(info, indent=2))
    return 0


def cmd_labs(args):
    course = Course()
    for i in course.items:
        if i["type"] != "lab":
            continue
        if args.module and not i["module"].startswith(args.module):
            continue
        if args.runtime and i["lab"]["runtime"] != args.runtime and \
                (i["lab"].get("fallback") or {}).get("runtime") != args.runtime:
            continue
        print(i["id"])
    return 0


# --------------------------------------------------------------------------

def main(argv=None):
    p = argparse.ArgumentParser(prog="course", description="Linux Basics — Hands-On course CLI")
    sub = p.add_subparsers(dest="cmd", metavar="command")

    s = sub.add_parser("list", help="show modules, lessons, quizzes and labs")
    s.add_argument("module", nargs="?")
    s.set_defaults(fn=cmd_list)
    s = sub.add_parser("syllabus", help="print SYLLABUS.md (markdown)")
    s.set_defaults(fn=cmd_syllabus)
    s = sub.add_parser("progress", help="show your progress")
    s.set_defaults(fn=cmd_progress)
    s = sub.add_parser("read", help="read a lesson or story and mark it read")
    s.add_argument("id")
    s.add_argument("--no-pager", action="store_true")
    s.set_defaults(fn=cmd_read)
    s = sub.add_parser("quiz", help="take a quiz")
    s.add_argument("id")
    s.add_argument("--answers", help="non-interactive: comma-separated answers, e.g. b,a,d")
    s.set_defaults(fn=cmd_quiz)

    def lab_cmd(name, fn, help_):
        s = sub.add_parser(name, help=help_)
        s.add_argument("lab")
        s.add_argument("--runtime", choices=["docker", "vm"], help="override the lab runtime")
        s.set_defaults(fn=fn)
        return s

    s = lab_cmd("start", cmd_start, "start a lab: bring up machines, run setup, open a shell")
    s.add_argument("--no-shell", action="store_true")
    s.add_argument("--fresh", action="store_true", help="recreate containers first")
    s = lab_cmd("shell", cmd_shell, "open a shell on a lab machine")
    s.add_argument("--service")
    s.add_argument("--user")
    lab_cmd("check", cmd_check, "grade a lab")
    s = lab_cmd("reset", cmd_reset, "reset a lab to its starting state")
    s.add_argument("--fresh", action="store_true", help="recreate containers first")
    s = sub.add_parser("hint", help="show the next hint for a lab task")
    s.add_argument("lab")
    s.add_argument("task")
    s.add_argument("--level", type=int)
    s.set_defaults(fn=cmd_hint)
    s = lab_cmd("solution", cmd_solution, "show the worked solution")
    s.add_argument("-y", "--yes", action="store_true")
    s = sub.add_parser("labs", help="list lab ids (for scripts)")
    s.add_argument("module", nargs="?")
    s.add_argument("--runtime", choices=["docker", "vm"])
    s.set_defaults(fn=cmd_labs)
    lab_cmd("info", cmd_info, "lab metadata as JSON (for scripts)").add_argument("field", nargs="?")
    lab_cmd("solution-script", cmd_solution_script, "emit a script applying solution.md (for tests)")

    args = p.parse_args(argv)
    if not getattr(args, "fn", None):
        p.print_help()
        return 0
    try:
        return args.fn(args) or 0
    except KeyboardInterrupt:
        print()
        return 130


if __name__ == "__main__":
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)  # behave like a normal CLI in pipes
    sys.exit(main())
