#!/usr/bin/env bash
# webctl - a deliberately tiny "service manager" for the web01 practice app.
# Reads /etc/webapp/webapp.conf (LISTEN_ADDR, LISTEN_PORT, MESSAGE).
set -u
CONF=/etc/webapp/webapp.conf
PIDFILE=/run/webapp.pid
LOG=/var/log/webapp.log

is_running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

start() {
  if is_running; then echo "webapp already running (pid $(cat "$PIDFILE"))"; return 0; fi
  # shellcheck disable=SC1090
  . "$CONF"
  nohup python3 - "$LISTEN_ADDR" "$LISTEN_PORT" "$MESSAGE" >>"$LOG" 2>&1 <<'PY' &
import http.server, sys
addr, port, msg = sys.argv[1], int(sys.argv[2]), sys.argv[3]
class H(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        body = (msg + "\n").encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
    def log_message(self, fmt, *args):
        sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))
http.server.ThreadingHTTPServer((addr, port), H).serve_forever()
PY
  echo $! >"$PIDFILE"
  sleep 0.5
  if is_running; then echo "webapp started on ${LISTEN_ADDR}:${LISTEN_PORT}"; else echo "webapp failed to start, see $LOG"; return 1; fi
}

stop() {
  if is_running; then kill "$(cat "$PIDFILE")"; rm -f "$PIDFILE"; echo "webapp stopped"; else echo "webapp not running"; fi
}

status() {
  if is_running; then echo "webapp is running (pid $(cat "$PIDFILE"))"; else echo "webapp is stopped"; fi
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 0.3; start ;;
  status) status ;;
  *) echo "usage: webctl start|stop|restart|status"; exit 2 ;;
esac
