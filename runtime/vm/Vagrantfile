# -*- mode: ruby -*-
# Linux Basics — Hands-On: VM runtime (Track B) for modules 02, 07 and 08.
#
#   vagrant up                 # bob-vm only
#   NFS=1 vagrant up           # also the optional nfs-server VM (module 08)
#   BOX=bento/rockylinux-9 vagrant up   # Red Hat flavoured VM instead
#
# bob-vm gets three blank data disks (1G, 1G, 2G) whose serial numbers are
# disk-a, disk-b and disk-c, so graders can find them under /dev/disk/by-id
# regardless of whether they show up as sda/sdb, vdb, nvme1n1, ...
# Providers: virtualbox (x86), libvirt, qemu (Apple Silicon), parallels, vmware_desktop.

BOX   = ENV.fetch("BOX", "bento/ubuntu-24.04")
DISKS = [["disk-a", 1], ["disk-b", 1], ["disk-c", 2]]   # name, size in GB
COURSE_ROOT = File.expand_path("../..", __dir__)

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.synced_folder COURSE_ROOT, "/course", mount_options: ["ro"]

  config.vm.define "bob-vm", primary: true do |vm|
    vm.vm.hostname = "bob-vm"
    vm.vm.network "private_network", ip: "192.168.56.10"

    vm.vm.provider "virtualbox" do |vb, override|
      vb.name = "linux-basics-bob-vm"
      vb.cpus = 2
      vb.memory = 2048
      DISKS.each_with_index do |(name, size), i|
        file = File.join(__dir__, ".disks", "#{name}.vdi")
        unless File.exist?(file)
          vb.customize ["createmedium", "disk", "--filename", file, "--size", size * 1024]
        end
        vb.customize ["storageattach", :id, "--storagectl", "SATA Controller",
                      "--port", i + 1, "--device", 0, "--type", "hdd", "--medium", file]
        vb.customize ["setextradata", :id,
                      "VBoxInternal/Devices/ahci/0/Config/Port#{i + 1}/SerialNumber", name]
      end
    end

    vm.vm.provider "libvirt" do |lv|
      lv.cpus = 2
      lv.memory = 2048
      DISKS.each { |name, size| lv.storage :file, size: "#{size}G", serial: name }
    end

    vm.vm.provider "qemu" do |qe|
      qe.smp = "2"
      qe.memory = "2048"
      args = []
      DISKS.each do |name, size|
        img = File.join(__dir__, ".disks", "#{name}.qcow2")
        system("mkdir -p #{File.dirname(img)} && [ -f #{img} ] || qemu-img create -q -f qcow2 #{img} #{size}G")
        args += ["-drive", "file=#{img},if=none,id=#{name},format=qcow2",
                 "-device", "virtio-blk-pci,drive=#{name},serial=#{name}"]
      end
      qe.extra_qemu_args = args
    end

    # Parallels / VMware: no stable serials; provision.sh falls back to
    # identifying blank disks by size and records them in /etc/course-disks.
    vm.vm.provider "parallels" do |prl|
      prl.cpus = 2
      prl.memory = 2048
    end
    ["vmware_desktop", "parallels"].each do |p|
      vm.vm.provider p do |_, override|
        DISKS.each { |name, size| override.vm.disk :disk, name: name, size: "#{size}GB" }
      end
    end

    vm.vm.provision "shell", path: "provision.sh", env: { "COURSE_ROLE" => "bob-vm" }
  end

  if ENV["NFS"] == "1"
    config.vm.define "nfs-server", autostart: true do |nfs|
      nfs.vm.hostname = "nfs-server"
      nfs.vm.network "private_network", ip: "192.168.56.20"
      nfs.vm.provider("virtualbox") { |vb| vb.cpus = 1; vb.memory = 1024 }
      nfs.vm.provider("libvirt") { |lv| lv.cpus = 1; lv.memory = 1024 }
      nfs.vm.provider("qemu") { |qe| qe.smp = "1"; qe.memory = "1024" }
      nfs.vm.provision "shell", path: "provision.sh", env: { "COURSE_ROLE" => "nfs-server" }
    end
  end
end
